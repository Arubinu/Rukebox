# Passwordless sudo for the account the services run as: specific commands only.
# Installed by scripts/install.sh and scripts/update.sh (checked with visudo).

pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl poweroff
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl reboot
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart rukebox-usb-gadget.service
pi ALL=(ALL) NOPASSWD: /usr/local/sbin/rukebox-flic-sdk
# The USB key the radio plays from. The helper is what checks the device, and
# it mounts read-only; nothing else on the machine is reachable through it.
pi ALL=(ALL) NOPASSWD: /usr/local/sbin/rukebox-usb-music mount *, /usr/local/sbin/rukebox-usb-music umount
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable --now flicd.service flic-bridge.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl disable --now flicd.service flic-bridge.service
# The daemon puts the Flic button on hold while the speaker needs the only
# Bluetooth controller there is, and starts it again once one is free.
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop flicd.service flic-bridge.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl start flicd.service flic-bridge.service

pi ALL=(ALL) NOPASSWD: /bin/date, /usr/bin/date
pi ALL=(ALL) NOPASSWD: /usr/sbin/hwclock, /sbin/hwclock

pi ALL=(ALL) NOPASSWD: /usr/bin/timedatectl set-timezone *

pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart rukebox-daemon.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart rukebox-web.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart bt-connect.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart home-wifi-connect.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart rukebox-speaker-buttons.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart rukebox-card-reader.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart rukebox-gpio-button.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart flicd.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart flic-bridge.service

pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable ssh, /usr/bin/systemctl disable ssh
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl start ssh, /usr/bin/systemctl stop ssh

pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop rukebox-gpio-button.service
pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl start rukebox-gpio-button.service

pi ALL=(ALL) NOPASSWD: /usr/bin/systemctl start rukebox-act-led.service

pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli connection up *, /usr/bin/nmcli connection down *
pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli connection modify * connection.autoconnect yes
pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli connection modify * connection.autoconnect no

pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli connection delete rukebox-ap
pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli connection add type wifi ifname uap0 con-name rukebox-ap *
pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli connection modify rukebox-ap *
pi ALL=(ALL) NOPASSWD: /usr/bin/nmcli -s -g 802-11-wireless-security.psk connection show rukebox-ap

pi ALL=(ALL) NOPASSWD: /usr/sbin/iw dev uap0 station dump
pi ALL=(ALL) NOPASSWD: /sbin/iw dev uap0 station dump
pi ALL=(ALL) NOPASSWD: /usr/sbin/iw dev uap0 station del *
pi ALL=(ALL) NOPASSWD: /sbin/iw dev uap0 station del *

pi ALL=(ALL) NOPASSWD: /usr/local/sbin/rukebox-update --from-git
pi ALL=(ALL) NOPASSWD: /usr/local/sbin/rukebox-update --from-git --quiet
pi ALL=(ALL) NOPASSWD: /usr/local/sbin/rukebox-update --from-release
