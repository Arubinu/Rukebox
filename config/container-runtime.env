# Where a container's own sound server keeps its sockets, for everything that
# has to find it: the three audio units, the daemon (mpv, pw-dump) and the web
# server (pactl, the network stream). Written by the installer's container
# profile alone; on a Pi the file is absent and the units ask for it with a
# leading "-", so nothing there reads it.
XDG_RUNTIME_DIR=/run/rukebox
PIPEWIRE_RUNTIME_DIR=/run/rukebox
PULSE_SERVER=unix:/run/rukebox/pulse/native
