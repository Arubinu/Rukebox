[Unit]
Description=Rukebox admin web interface
After=network.target rukebox-daemon.service rukebox-config.service
Wants=rukebox-daemon.service
Requires=rukebox-config.service

[Service]
EnvironmentFile=/etc/rukebox/rukebox.env
# Absent on a Pi; a container writes it so the stream finds the sound server the
# container runs itself (see config/container-runtime.env).
EnvironmentFile=-/etc/rukebox/container-runtime.env
ExecStart=/usr/bin/python3 /opt/rukebox/src/web_server.py
Restart=always
RestartSec=5
User=pi
AmbientCapabilities=CAP_NET_BIND_SERVICE
# The updater started from the page is a child of this service and stops it to swap the
# files: only the main process is signalled, so the updater survives to restart it.
KillMode=process

[Install]
WantedBy=multi-user.target
