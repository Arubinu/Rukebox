[Unit]
Description=Bridge between the Bluetooth speaker's own buttons (AVRCP) and the radio daemon
After=rukebox-daemon.service rukebox-config.service bluetooth.service
Wants=rukebox-config.service

[Service]
ExecStart=/usr/bin/python3 /opt/rukebox/src/speaker_buttons.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
