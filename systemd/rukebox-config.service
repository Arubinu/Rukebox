[Unit]
Description=Prepares the radio configuration (YAML -> flat env file for the other units)
Before=rukebox-daemon.service rukebox-web.service flicd.service flic-bridge.service bt-connect.service home-wifi-connect.service
DefaultDependencies=no
After=local-fs.target
Requires=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/rukebox/src/config_file.py ensure
# WirePlumber reads the offered Bluetooth codecs from a drop-in of its own.
ExecStart=/usr/bin/python3 /opt/rukebox/src/bt_codec.py write

[Install]
WantedBy=multi-user.target
