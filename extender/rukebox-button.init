#!/bin/sh /etc/rc.common
# Starts the button watcher on the router, and starts it again if it stops.

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/rukebox-button run
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
